# ---- ESPN source league (public, no auth needed) ----
#   271475     West Hills FFL - 2026 draft COMPLETE (215 picks). Realistic
#              leftovers pool. Standard QB/RB/WR/TE/K slots, PPR ranks.
#   1005162176 Test 2026 Claude League - not drafted, every star available.
# Avoid 398886 (Forever 49): uses TQB, so it has ZERO individual QB free agents.
ESPN_LEAGUE_ID=271475
ESPN_SEASON=2026

# ---- Draft state store ----
# "file"  = local dev only (.data/room.json, in-process lock)
# "redis" = serverless / deployed (Upstash, compare-and-set)
DRAFT_STORE=file

# Required only when DRAFT_STORE=redis. Either naming works:
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN  (upstash.com signup)
#   KV_REST_API_URL        / KV_REST_API_TOKEN         (Vercel Marketplace)
# Must be the REST URL (https://...), not a redis:// string.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxx
